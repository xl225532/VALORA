*{

margin:0;

padding:0;

box-sizing:border-box;

font-family:'Cairo',Arial,sans-serif;

}



body{

background:#050B16;

color:white;

min-height:100vh;

}



.pin-page{

max-width:480px;

margin:auto;

padding:18px 15px;

}




/* HEADER */

.page-header{

display:flex;

align-items:center;

gap:15px;

margin-bottom:25px;

}



.page-header a{

font-size:38px;

color:white;

text-decoration:none;

}



.page-header h2{

font-size:20px;

}






/* CARD */

.pin-card{

background:#0B1628;

border:1px solid #17365C;

border-radius:20px;

padding:20px;

text-align:center;

margin-bottom:15px;

}



.pin-icon{

font-size:45px;

margin-bottom:10px;

}



.pin-card p{

color:#98A5B8;

font-size:13px;

margin-top:8px;

}






/* FORM */

.form-card{

background:#0B1628;

border:1px solid #17365C;

border-radius:18px;

padding:18px;

}



.form-card label{

display:block;

color:#CBD5E1;

font-size:14px;

margin:12px 0 6px;

}



.form-card input{

width:100%;

background:#071426;

border:1px solid #17365C;

border-radius:14px;

padding:13px;

color:white;

font-size:18px;

text-align:center;

outline:none;

}



.form-card input:focus{

border-color:#1687FF;

}




.form-card button{

width:100%;

background:#1687FF;

border:0;

border-radius:14px;

padding:14px;

color:white;

font-weight:bold;

font-size:15px;

margin-top:20px;

}
